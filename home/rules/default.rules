prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "& 'C:\\Users\\Administrator\\Desktop\\codex\\codex.exe' exec --ephemeral --sandbox read-only --skip-git-repo-check -C 'C:\\Users\\Administrator\\Desktop\\codex' \"只做只读工具验证：执行 PowerShell Get-Location；读取 env.ps1 的前 3 行；搜索当前根目录下这些 Project-owned 文件中的 code_mode_host：run-codex.ps1、env.ps1、检查工具.ps1、升级Codex到0.153.2.ps1、MIGRATION-MANIFEST.json、TOOL-INVENTORY.md。不要读取 home/auth.json，不修改任何文件。输出工具结果及是否出现 host spawn/handshake/protocol/crash/access denied 错误。\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "Get-CimInstance Win32_Process -Filter \"Name='codex.exe' OR Name='codex-code-mode-host.exe'\" | Select-Object ProcessId,ParentProcessId,CommandLine | Format-List"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "$root='C:\\Users\\Administrator\\Desktop\\codex'; $sync=Join-Path $root 'work\\r23-live-sync'; $zip=Join-Path $root 'work\\r23-live-sync.zip'; $names=@('run-codex.ps1','检查工具.ps1','升级Codex到0.153.2.ps1','MIGRATION-MANIFEST.json','TOOL-INVENTORY.md'); if(Test-Path -LiteralPath $sync){Get-ChildItem -LiteralPath $sync -Force | Remove-Item -Recurse -Force}; New-Item -ItemType Directory -Path $sync -Force | Out-Null; foreach($n in $names){$src=Join-Path $root $n; if(-not(Test-Path -LiteralPath $src -PathType Leaf)){throw \"Missing source: $src\"}; Copy-Item -LiteralPath $src -Destination (Join-Path $sync $n) -Force}; $rows=@(); foreach($n in $names){$p=Join-Path $sync $n; $i=Get-Item -LiteralPath $p -Force; $rows += [pscustomobject]@{Path=$n;Size=$i.Length;Hash=(Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant()}}; $rows | ConvertTo-Json -Compress | Set-Content -LiteralPath (Join-Path $sync '._hashes.json') -Encoding UTF8; if(Test-Path -LiteralPath $zip){Remove-Item -LiteralPath $zip -Force}; Compress-Archive -LiteralPath ($names | ForEach-Object {Join-Path $sync $_}) -DestinationPath $zip -CompressionLevel Optimal -Force; Remove-Item -LiteralPath (Join-Path $sync '._hashes.json') -Force; if((Get-ChildItem -LiteralPath $sync -Force).Count -ne 5){throw 'Sync directory contains unexpected entries'}; $zipHash=(Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash.ToLowerInvariant(); Write-Output ('ZIP '+$zip); Write-Output ('ZIP_SHA256 '+$zipHash); foreach($row in $rows){Write-Output (\"FILE {0}|{1}|{2}\" -f $row.Path,$row.Size,$row.Hash)}"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "$root='C:\\Users\\Administrator\\Desktop\\codex'; $sync=Join-Path $root 'work\\r23-live-sync'; $zip=Join-Path $root 'work\\r23-live-sync.zip'; $names=@('run-codex.ps1','检查工具.ps1','升级Codex到0.153.2.ps1','MIGRATION-MANIFEST.json','TOOL-INVENTORY.md','SYNC-HASHES.txt'); if((Get-ChildItem -LiteralPath $sync -Force).Count -ne 6){throw 'Unexpected sync directory contents'}; foreach($n in $names){if(-not(Test-Path -LiteralPath (Join-Path $sync $n) -PathType Leaf)){throw \"Missing sync file: $n\"}}; if(Test-Path -LiteralPath $zip){Remove-Item -LiteralPath $zip -Force}; Compress-Archive -LiteralPath ($names | ForEach-Object {Join-Path $sync $_}) -DestinationPath $zip -CompressionLevel Optimal -Force; Write-Output ('ZIP path: '+$zip); Write-Output ('ZIP SHA-256: '+(Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash.ToLowerInvariant()); Write-Output 'ZIP entries:'; Add-Type -AssemblyName System.IO.Compression.FileSystem; $a=[IO.Compression.ZipFile]::OpenRead($zip); try{$a.Entries|ForEach-Object FullName}catch{}finally{$a.Dispose()}; Write-Output 'FILE HASHES:'; foreach($n in @('run-codex.ps1','检查工具.ps1','升级Codex到0.153.2.ps1','MIGRATION-MANIFEST.json','TOOL-INVENTORY.md')){$p=Join-Path $sync $n;$i=Get-Item -LiteralPath $p;Write-Output (\"{0}|{1}|{2}\" -f $n,$i.Length,(Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant())}"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "$root='C:\\Users\\Administrator\\Desktop\\codex'; $zip=Join-Path $root 'work\\R23-decision-sync-patch.zip'; $stage=Join-Path $root 'work\\r23-decision-sync-staging'; if(Test-Path -LiteralPath $stage){Remove-Item -LiteralPath $stage -Recurse -Force}; New-Item -ItemType Directory -Path $stage | Out-Null; Expand-Archive -LiteralPath $zip -DestinationPath $stage -Force; Add-Type -AssemblyName System.IO.Compression.FileSystem; $a=[IO.Compression.ZipFile]::OpenRead($zip); try{$entries=@($a.Entries|ForEach-Object FullName)}finally{$a.Dispose()}; $expected=@('run-codex.ps1','升级Codex到0.153.2.ps1','tool/project-regression-r19.py','SYNC-HASHES.txt'); Write-Output 'ENTRIES'; $entries|ForEach-Object{Write-Output $_}; if(@(Compare-Object ($entries|Sort-Object) ($expected|Sort-Object)).Count -ne 0){throw 'ZIP entries mismatch'}; $checks=@(@('run-codex.ps1','80796a3863207ccc6b648b487e7b5b6b512656bbaf42997461f5f9819f8ee0e6'),@('升级Codex到0.153.2.ps1','c5b5a8febbdb876640903e41926610b86deadec0589fd0767887008ff0039c6a'),@('tool\\project-regression-r19.py','5c7c8a0547bbe4e66a7c3b54f09b600bb5fb85676f45abfacf5a037895ee1927')); foreach($c in $checks){$p=Join-Path $stage $c[0]; if(-not(Test-Path -LiteralPath $p -PathType Leaf)){throw \"Missing staged file $($c[0])\"}; $h=(Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant(); Write-Output (\"STAGED {0}|{1}|{2}\" -f $c[0],(Get-Item -LiteralPath $p).Length,$h); if($h -ne $c[1]){throw \"Staged hash mismatch $($c[0])\"}}; Write-Output 'STAGING_VALID'"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "$root='C:\\Users\\Administrator\\Desktop\\codex'; $zip=Join-Path $root 'work\\R23-decision-sync-patch.zip'; $stage=Join-Path $root 'work\\r23-decision-sync-staging'; if(Test-Path -LiteralPath $stage){Remove-Item -LiteralPath $stage -Recurse -Force}; New-Item -ItemType Directory -Path $stage | Out-Null; Add-Type -AssemblyName System.IO.Compression.FileSystem; $a=[IO.Compression.ZipFile]::OpenRead($zip); try{$fileEntries=@($a.Entries|Where-Object{-not [string]::IsNullOrWhiteSpace($_.Name)}); if($fileEntries.Count -ne 4){throw \"Expected 4 file entries, got $($fileEntries.Count)\"}; foreach($e in $fileEntries){$dest=Join-Path $stage ($e.FullName.Replace('/','\\')); $parent=Split-Path -Parent $dest; if(-not(Test-Path -LiteralPath $parent)){New-Item -ItemType Directory -Path $parent -Force|Out-Null}; [IO.Compression.ZipFileExtensions]::ExtractToFile($e,$dest,$true)}; Write-Output 'ZIP_FILE_ENTRIES'; $fileEntries|ForEach-Object{Write-Output $_.FullName}}finally{$a.Dispose()}; $checks=@(@('run-codex.ps1','80796a3863207ccc6b648b487e7b5b6b512656bbaf42997461f5f9819f8ee0e6'),@('升级Codex到0.153.2.ps1','c5b5a8febbdb876640903e41926610b86deadec0589fd0767887008ff0039c6a'),@('tool\\project-regression-r19.py','5c7c8a0547bbe4e66a7c3b54f09b600bb5fb85676f45abfacf5a037895ee1927')); foreach($c in $checks){$p=Join-Path $stage $c[0]; if(-not(Test-Path -LiteralPath $p -PathType Leaf)){throw \"Missing staged file $($c[0])\"}; $h=(Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant(); Write-Output (\"STAGED|{0}|{1}|{2}\" -f $c[0],(Get-Item -LiteralPath $p).Length,$h); if($h -ne $c[1]){throw \"Staged hash mismatch $($c[0])\"}}; Write-Output 'STAGING_VALID'"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "$root='C:\\Users\\Administrator\\Desktop\\codex'; $zip=Join-Path $root 'work\\R23-decision-sync-patch.zip'; $stage=Join-Path $root 'work\\r23-decision-sync-staging'; if(Test-Path -LiteralPath $stage){Remove-Item -LiteralPath $stage -Recurse -Force}; New-Item -ItemType Directory -Path $stage | Out-Null; $z=Join-Path $root 'tool\\bin\\7z.exe'; if(-not(Test-Path -LiteralPath $z -PathType Leaf)){throw '7z missing'}; & $z x $zip (('-o'+$stage)) -y; if($LASTEXITCODE -ne 0){throw \"7z exit $LASTEXITCODE\"}; Write-Output 'EXTRACT_DONE'; Get-ChildItem -LiteralPath $stage -Recurse -File | ForEach-Object {Write-Output (\"FILE|{0}|{1}|{2}\" -f $_.FullName.Substring($stage.Length+1),$_.Length,(Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash.ToLowerInvariant())}"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "$root='C:\\Users\\Administrator\\Desktop\\codex'; $stage=Join-Path $root 'work\\r23-decision-sync-staging'; Copy-Item -LiteralPath (Join-Path $stage 'run-codex.ps1') -Destination (Join-Path $root 'run-codex.ps1') -Force; Copy-Item -LiteralPath (Join-Path $stage '升级Codex到0.153.2.ps1') -Destination (Join-Path $root '升级Codex到0.153.2.ps1') -Force; Copy-Item -LiteralPath (Join-Path $stage 'tool\\project-regression-r19.py') -Destination (Join-Path $root 'tool\\project-regression-r19.py') -Force; foreach($p in @((Join-Path $root 'run-codex.ps1'),(Join-Path $root '升级Codex到0.153.2.ps1'),(Join-Path $root 'tool\\project-regression-r19.py'))){$i=Get-Item -LiteralPath $p; Write-Output (\"SYNCED|{0}|{1}|{2}\" -f $p,$i.Length,(Get-FileHash -LiteralPath $p -Algorithm SHA256).Hash.ToLowerInvariant())}"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "& 'C:\\Users\\Administrator\\Desktop\\codex\\升级Codex到0.153.2.bat' -VerifyOnly; Write-Output ('EXIT|'+$LASTEXITCODE)"], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "$root='C:\\Users\\Administrator\\Desktop\\codex'; $c=Join-Path $root 'codex.exe'; $h=Join-Path $root 'codex-code-mode-host.exe'; Write-Output ('codex SHA|'+(Get-FileHash -LiteralPath $c -Algorithm SHA256).Hash.ToLowerInvariant()); Write-Output ('host SHA|'+(Get-FileHash -LiteralPath $h -Algorithm SHA256).Hash.ToLowerInvariant()); $s=Get-AuthenticodeSignature -LiteralPath $h; Write-Output ('host Authenticode|'+$s.Status); if($s.SignerCertificate){Write-Output ('signer|'+$s.SignerCertificate.Subject);Write-Output ('issuer|'+$s.SignerCertificate.Issuer)}; Write-Output '--- CODE MODE TEST ---'; & $c exec --ephemeral --sandbox read-only --skip-git-repo-check -C $root \"只做只读工具测试：执行 PowerShell Get-Location；读取 env.ps1 第一行；不要读取 home/auth.json，不修改任何文件。只报告工具结果，以及是否出现 failed to spawn code-mode host、handshake、protocol、crash、access denied。\""], decision="allow")
prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-NoProfile", "-Command", "$root='C:\\Users\\Administrator\\Desktop\\codex'; $log=Join-Path $root 'work\\r23-regression-winerror5.log'; if(Test-Path -LiteralPath $log){Remove-Item -LiteralPath $log -Force}; & (Join-Path $root 'tool\\python\\python.exe') (Join-Path $root 'tool\\project-regression-r19.py') 2>&1 | ForEach-Object { $_ | Out-File -LiteralPath $log -Append -Encoding UTF8; Write-Output $_ }; $code=$LASTEXITCODE; Write-Output ('REGRESSION_EXIT|'+$code); Write-Output ('LOG_PATH|'+$log); Write-Output ('LOG_SIZE|'+(Get-Item -LiteralPath $log).Length)"], decision="allow")

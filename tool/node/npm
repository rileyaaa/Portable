#!/usr/bin/env bash
# Git Bash uses the same NTFS-aware guarded entrypoint as PowerShell.
# Arguments remain an array; no command reconstruction or host npm fallback.
script_path=${BASH_SOURCE[0]}
case "$script_path" in
  */*) entry_dir=${script_path%/*} ;;
  *) printf '%s\n' 'Cannot locate the portable npm entrypoint.' >&2; exit 3 ;;
esac
system_root=${SystemRoot:-${SYSTEMROOT:-${WINDIR:-}}}
if [[ -z "$system_root" ]]; then
  printf '%s\n' 'This portable npm entrypoint requires Windows.' >&2
  exit 3
fi
system_root=${system_root//\\//}
export POWERSHELL_TELEMETRY_OPTOUT=1
export PSModuleAnalysisCachePath=NUL
exec "$system_root/System32/WindowsPowerShell/v1.0/powershell.exe" \
  -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$entry_dir/npm.ps1" "$@"

env.local.ps1

# Runtime credentials and generated state
/home/.ssh/
/home/ssh/
/work/
home/auth*.json
home/auth*.json.*
home/mode

# Imported account credentials and generated reports
login_json/*.json
login_json/*.csv
login_json/**/*.json
login_json/**/*.csv

# Runtime lock and machine-generated Codex state
.codex-portable.instance.lock
.codex-browser.instance.lock
home/config.toml
home/model-catalog*.json
home/model-catalog*.json.version
home/installation_id
home/cap_sid

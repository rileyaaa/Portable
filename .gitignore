# Portable process data: never publish caches, session content or sandbox secrets.
/tmp/
/cache/
/logs/
/sqlite/
/appdata/
/localappdata/
/programdata/
/home-runtime/
/home/.sandbox/
/home/.sandbox-bin/
/home/.sandbox-secrets/
/home/tmp/
/home/log/
/home/sessions/
/home/archived_sessions/
/home/shell_snapshots/
/home/memories/
/home/history.jsonl
/home/models_cache.json
/home/*.sqlite
/home/*.sqlite-*
/home/*.db
/home/auth-transition.block
/home/logout-*.block
/home/portable-extensions.toml
/home/.codex-global-state*.json

# Regenerable Python bytecode is not part of the portable runtime payload.
__pycache__/
*.pyc
*.pyo
